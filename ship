import pygame

class Ship:
    """ Classe para gerir a nave do jogador """
    
    def __init__(self,ai_game):
        
        """ Inicializar a nave e definir a sua posição inicial """
        self.screen = ai_game.screen
        self.settings = ai_game.settings
        self.screen_rect = ai_game.screen.get_rect()
        
        # Carregar a imagem da nave
        self.image = pygame.image.load('images/nave.png')
        self.rect = self.image.get_rect()
        
        # Definir a posição da nave
        self.rect.midbottom = self.screen_rect.midbottom
        
        #Armazena um valor decima  para a posição horizontal da nave
        self.x = float(self.rect.x)
        
        #Variaveis de controlo de movimento da nave
        self.moving_left = False
        self.moving_rigth = False
    
    def update(self):
        """ Atualiza a posição da nave """
        if self.moving_rigth and self.rect.right < self.screen_rect.right:
            self.x += self.settings.ship_speed
        if self.moving_left and self.rect.left > 0:
            self.x -= self.settings.ship_speed
        self.rect.x = self.x
        
    def blitme(self):
        """ Desenhar a nave na sua posição atual """
        self.screen.blit(self.image, self.rect) 
